---
import Layout from "../layouts/Layout.astro";
import HomeContent from "../components/HomeContent.astro";

export function getStaticPaths() {
  return ["experiencia", "proyectos", "habilidades", "sobre-mi", "contacto"].map((section) => ({
    params: { section },
  }));
}

const { section } = Astro.params;
---

<Layout>
  <HomeContent />
  <script is:inline define:vars={{ section }}>
    document.getElementById(section)?.scrollIntoView({ behavior: "auto" });
  </script>
</Layout>
