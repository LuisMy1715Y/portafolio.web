---
import Button from "./Button.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Logo from "./Logo.astro";
import MenuIcon from "./Icons/Menu.astro";
import CloseIcon from "./Icons/Close.astro";
import { profile } from "../data/profile";

const navItems = [
  { label: "Experiencia", href: "/#experiencia" },
  { label: "Proyectos", href: "/#proyectos" },
  { label: "Sobre mí", href: "/#sobre-mi" },
  { label: "Contacto", href: "/#contacto" },
];
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${profile.name}, ir al inicio`}>
      <Logo variant="lineal" size="sm" />
      <span class="brand-name">{profile.name}</span>
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li class="nav-item">
              <a class="nav-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <div class="header-cta">
        <Button href={`mailto:${profile.email}`} size="sm">Contáctame</Button>
      </div>
      <ThemeToggle />
      <button
        class="menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
      >
        <MenuIcon />
        <CloseIcon />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="menu-movil" data-menu-panel hidden>
    <nav class="container mobile-menu-inner" aria-label="Navegación móvil">
      <ul class="mobile-list">
        {
          navItems.map((item) => (
            <li>
              <a class="mobile-link" href={item.href} data-menu-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-cta" data-menu-link>
        <Button href={`mailto:${profile.email}`}>Contáctame</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const initMenu = () => {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
    if (!header || !toggle || !panel) return;

    const links = Array.from(panel.querySelectorAll<HTMLElement>("[data-menu-link]"));
    const desktop = window.matchMedia("(min-width: 768px)");

    const open = () => {
      panel.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Cerrar menú");
      panel.querySelector<HTMLElement>("a")?.focus();
    };

    const close = (returnFocus: boolean) => {
      if (panel.hidden) return;
      panel.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menú");
      if (!returnFocus) return;
      toggle.focus();
    };

    toggle.addEventListener("click", () => {
      if (!panel.hidden) return close(true);
      open();
    });

    links.forEach((link) => link.addEventListener("click", () => close(false)));

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      close(true);
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (header.contains(target)) return;
      close(false);
    });

    desktop.addEventListener("change", () => close(false));
  };

  initMenu();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: var(--border-w) solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-3);
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    min-height: var(--tap);
    color: var(--ink);
  }

  .brand-name {
    display: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .header-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-1);
  }

  .nav,
  .header-cta {
    display: none;
  }

  .nav-list {
    display: flex;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--space-2);
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-weight: var(--fw-medium);
    transition: color var(--t-fast) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: var(--radius-md);
    color: var(--ink-2);
    transition:
      color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }

  .menu-toggle:hover {
    color: var(--ink);
    background: var(--surface-2);
  }

  .menu-toggle:focus-visible {
    border-radius: var(--radius-md);
  }

  .menu-toggle :global(.icon) {
    grid-area: 1 / 1;
    width: var(--icon-md);
    height: var(--icon-md);
  }

  .menu-toggle :global([data-icon="close"]),
  .menu-toggle[aria-expanded="true"] :global([data-icon="menu"]) {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] :global([data-icon="close"]) {
    display: block;
  }

  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    border-bottom: var(--border-w) solid var(--line);
    box-shadow: var(--shadow-sm);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu-inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-2) var(--space-4);
  }

  .mobile-list {
    display: grid;
  }

  .mobile-list li + li {
    border-top: var(--border-w) solid var(--line-soft);
  }

  .mobile-link {
    display: flex;
    align-items: center;
    min-height: var(--tap-lg);
    color: var(--ink-2);
    font-size: var(--text-body);
    font-weight: var(--fw-medium);
    transition: color var(--t-fast) var(--ease-out);
  }

  .mobile-link:hover {
    color: var(--ink);
  }

  .mobile-cta {
    display: grid;
  }

  @media (min-width: 440px) {
    .brand-name {
      display: inline;
    }
  }

  @media (min-width: 768px) {
    .nav {
      display: block;
      flex-shrink: 0;
      margin-left: auto;
    }

    .header-cta {
      display: block;
    }

    .header-actions {
      gap: var(--space-2);
    }

    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .header-inner {
      column-gap: var(--space-4);
    }

    .brand-name {
      font-size: var(--text-sm);
    }

    .nav-list {
      gap: var(--space-1);
    }

    .nav-link {
      padding-inline: var(--space-3);
      font-size: var(--text-sm);
    }
  }
</style>
