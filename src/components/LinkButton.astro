---
const { href } = Astro.props;
---

<a
  target="_blank"
  href={href}
  role="link"
  class="group inline-flex max-w-fit items-center justify-center gap-2 rounded-xl border border-[#A78BFA]/25 bg-[#201C2B] px-3 py-2 text-base text-[#D5CCE4] shadow-sm shadow-black/20 transition hover:border-[#F472B6]/55 hover:bg-[#33233C] hover:text-[#F8A9D2] focus:outline-none focus-visible:ring focus-visible:ring-[#F472B6] focus-visible:ring-offset-2 focus-visible:ring-offset-[#11121A] active:bg-[#402743]"
>
  <slot />
</a>
