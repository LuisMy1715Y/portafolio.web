---
import Panel from "./Panel.astro";
import ArrowUpRight from "./Icons/ArrowUpRight.astro";
import { certifications } from "../data/certifications";

const sorted = [...certifications].sort((a, b) => Number(b.year) - Number(a.year));
---

<Panel title="Certificaciones">
  <ul class="cert-list">
    {
      sorted.map((cert) => (
        <li class="cert">
          <p class="cert-info">
            <span class="cert-title">{cert.title}</span>
            <span class="cert-issuer">· {cert.issuer}</span>
          </p>
          <a class="cert-link" href={cert.link} target="_blank" rel="noopener noreferrer">
            <span class="sr-only">Ver certificado de {cert.title}, </span>
            <span class="tabular">{cert.year}</span>
            <span class="sr-only"> (se abre en una pestaña nueva)</span>
            <ArrowUpRight />
          </a>
        </li>
      ))
    }
  </ul>
</Panel>

<style>
  .cert {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .cert + .cert {
    border-top: var(--border-w) solid var(--line);
  }

  .cert-info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-2);
    line-height: var(--leading-snug);
  }

  .cert-title {
    color: var(--ink);
    font-size: var(--text-body);
    font-weight: var(--fw-semibold);
  }

  .cert-issuer {
    color: var(--ink-4);
    font-size: var(--text-sm);
  }

  .tabular {
    font-variant-numeric: tabular-nums;
  }

  .cert-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--tap);
    min-width: var(--tap);
    padding-inline: var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--accent-text);
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    transition: color var(--t-fast) var(--ease-out);
  }

  .cert-link:hover {
    color: var(--ink);
  }

  .cert-link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }
</style>
