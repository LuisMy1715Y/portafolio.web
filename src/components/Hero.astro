---
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import MailIcon from "./Icons/Mail.astro";
import CVIcon from "./Icons/CV.astro";
import LinkedInIcon from "./Icons/LinkedIn.astro";
import GitHubIcon from "./Icons/GitHub.astro";
import { Image } from "astro:assets";
import heroPhoto from "../assets/hero.png";
import { profile } from "../data/profile";
import StackAtom from "./StackAtom.astro";
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="container hero-inner">
    <div class="hero-copy">
      <div class="hero-top">
        <Image
          class="hero-photo"
          src={heroPhoto}
          alt={`Retrato de ${profile.name}`}
          width={144}
          height={144}
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <Badge variant="status">{profile.availability}</Badge>
      </div>

      <div class="hero-heading">
        <p class="eyebrow">{profile.role}</p>
        <h1 class="hero-title" id="hero-titulo">
          <span class="hero-name">{profile.name}</span>
          <span class="hero-headline">
            {profile.headline} <em class="hero-accent">{profile.headlineAccent}</em>
          </span>
        </h1>
        <p class="hero-intro">{profile.intro}</p>
      </div>

      <div class="hero-actions">
        <Button href={`mailto:${profile.email}`}>
          <MailIcon />
          Contáctame
        </Button>
        <Button href={profile.cv} variant="secondary" external>
          <CVIcon />
          Ver CV
        </Button>
        <div class="hero-social">
          <Button href={profile.github} variant="ghost" size="icon" external label="GitHub de Luis Miguel Hernández">
            <GitHubIcon />
          </Button>
          <Button href={profile.linkedin} variant="ghost" size="icon" external label="LinkedIn de Luis Miguel Hernández">
            <LinkedInIcon />
          </Button>
        </div>
      </div>
    </div>

    <div class="hero-visual">
      <StackAtom />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--hero-pad-y);
    overflow-x: clip;
  }

  .hero-inner {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: var(--hero-gap);
    justify-items: start;
    min-width: 0;
  }

  .hero-visual {
    display: none;
  }

  .hero-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .hero-photo {
    width: var(--avatar-md);
    height: var(--avatar-md);
    border-radius: var(--radius-full);
    border: var(--border-w) solid var(--line);
    object-fit: cover;
    background: var(--surface-2);
  }

  .hero-heading {
    display: grid;
    gap: var(--space-4);
  }

  .hero-title {
    display: grid;
    gap: var(--space-3);
  }

  .hero-name {
    color: var(--ink-3);
    font-size: var(--text-lg);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-normal);
  }

  .hero-headline {
    max-width: var(--measure-tight);
    color: var(--ink);
    font-size: var(--text-display);
    font-weight: var(--fw-semibold);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .hero-accent {
    color: var(--accent-text);
    font-style: normal;
  }

  .hero-intro {
    max-width: var(--measure);
    color: var(--ink-4);
    font-size: var(--text-body);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .hero-social {
    display: flex;
    gap: var(--space-1);
  }

  @media (max-width: 767.98px) {
    .hero-top {
      flex-wrap: nowrap;
      gap: var(--space-3);
    }

    .hero-photo {
      flex-shrink: 0;
      width: var(--avatar-hero-sm);
      height: var(--avatar-hero-sm);
    }

    .hero-top :global(.badge) {
      min-width: 0;
    }

    .hero-headline {
      font-size: var(--text-display-sm);
      line-height: var(--leading-tight);
    }

    .hero-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-self: stretch;
    }

    .hero-social {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .hero-visual {
      display: grid;
      place-items: center;
    }

    .hero-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
