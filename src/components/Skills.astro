---
import Panel from "./Panel.astro";
import { skills } from "../data/skills";
---

<Panel title="Habilidades">
  <ul class="groups">
    {
      skills.map((group) => (
        <li class="group">
          <h4 class="group-label">{group.title}</h4>
          <ul class="chips" aria-label={group.title}>
            {group.items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</Panel>

<style>
  .groups {
    display: grid;
    gap: var(--space-6);
  }

  .group {
    display: grid;
    gap: var(--space-3);
  }

  .group + .group {
    padding-top: var(--space-6);
    border-top: var(--border-w) solid var(--line-soft);
  }

  .group-label {
    color: var(--ink-3);
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-normal);
    line-height: var(--leading-snug);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: var(--chip-h);
    padding: var(--space-1) var(--space-3);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .group {
      grid-template-columns: var(--label-col) minmax(0, 1fr);
      align-items: start;
      column-gap: var(--space-4);
    }

    .group-label {
      padding-top: calc((var(--chip-h) - var(--text-sm) * var(--leading-snug)) / 2);
    }
  }
</style>
