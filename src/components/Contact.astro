---
import Section from "./Section.astro";
import Button from "./Button.astro";
import MailIcon from "./Icons/Mail.astro";
import CVIcon from "./Icons/CV.astro";
import { profile } from "../data/profile";
---

<Section id="contacto" title="¿Hablamos?">
  <div class="contact">
    <p class="contact-text">Busco mi próximo rol como desarrollador junior. Escríbeme o revisa mi CV.</p>
    <div class="contact-actions">
      <Button href={`mailto:${profile.email}`}>
        <MailIcon />
        Contáctame
      </Button>
      <Button href={profile.cv} variant="secondary" external>
        <CVIcon />
        Ver CV
      </Button>
    </div>
    <p class="contact-email">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  .contact-text {
    max-width: var(--measure);
    color: var(--ink-3);
    font-size: var(--text-lg);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .contact-email {
    color: var(--ink-4);
    font-size: var(--text-body);
    overflow-wrap: anywhere;
  }

  .contact-email a {
    padding-block: var(--space-3);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: var(--space-1);
    transition: color var(--t-fast) var(--ease-out);
  }

  .contact-email a:hover {
    color: var(--ink);
  }
</style>
