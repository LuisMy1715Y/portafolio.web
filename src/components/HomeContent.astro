---
import Experience from "./Experience.astro";
import SectionContainer from "./SectionContainer.astro";
import CodeIcon from "./Icons/Code.astro";
import Projects from "./Projects.astro";
import Hero from "./Hero.astro";
import Briefcase from "./Icons/Briefcase.astro";
import TitleSection from "./TitleSection.astro";
import ProfileCheck from "./Icons/ProfileCheck.astro";
import AboutMe from "./AboutMe.astro";
import LogroIcon from "./Icons/Logro.astro";
import Logros from "./Logros.astro";
import Slider from "./Slider.astro";
---

<main class="px-4" id="inicio">
  <SectionContainer class="py-44 pb-32">
    <Hero />
  </SectionContainer>
</main>

<div class="space-y-24">
  <SectionContainer>
    <Slider />
  </SectionContainer>

  <SectionContainer id="experiencia">
    <TitleSection>
      <Briefcase class="size-8" />
      Experiencia Laboral
    </TitleSection>
    <Experience />
  </SectionContainer>

  <SectionContainer id="proyectos">
    <TitleSection>
      <CodeIcon class="" />
      Proyectos
    </TitleSection>
    <Projects />
  </SectionContainer>

  <SectionContainer>
    <TitleSection>
      <LogroIcon class="size-8" />
      Logros
    </TitleSection>
    <Logros />
  </SectionContainer>

  <SectionContainer id="sobre-mi">
    <TitleSection>
      <ProfileCheck class="size-8" />
      Sobre mí
    </TitleSection>
    <AboutMe />
  </SectionContainer>
</div>
