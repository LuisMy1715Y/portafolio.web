---
import Hero from "./Hero.astro";
import Section from "./Section.astro";
import ProjectGrid from "./ProjectGrid.astro";
import ExperienceList from "./ExperienceList.astro";
import Skills from "./Skills.astro";
import Certifications from "./Certifications.astro";
import AboutMe from "./AboutMe.astro";
import Contact from "./Contact.astro";
---

<main id="contenido">
  <Hero />

  <Section id="experiencia" title="Experiencia">
    <ExperienceList />
  </Section>

  <Section id="proyectos" title="Proyectos">
    <ProjectGrid />
  </Section>

  <Section id="habilidades" title="Habilidades y certificaciones">
    <div class="skills-certs">
      <Skills />
      <Certifications />
    </div>
  </Section>

  <Section id="sobre-mi" title="Sobre mí">
    <AboutMe />
  </Section>

  <Contact />
</main>

<style>
  .skills-certs {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .skills-certs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
