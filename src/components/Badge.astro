---
interface Props {
  variant?: "neutral" | "status";
}

const { variant = "neutral" } = Astro.props;
---

<span class="badge" data-variant={variant}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--ink-3);
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    line-height: var(--leading-snug);
    white-space: nowrap;
  }

  .badge[data-variant="status"] {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--text-sm);
    white-space: normal;
  }

  .badge[data-variant="status"]::before {
    content: "";
    flex-shrink: 0;
    width: var(--dot);
    height: var(--dot);
    border-radius: var(--radius-full);
    background: var(--green);
    box-shadow: 0 0 0 var(--ring-w) var(--green-soft);
  }
</style>
