---
import GitHub from "./Icons/GitHub.astro";
import React from "./Icons/React.astro";
import TypeScript from "./Icons/TypeScript.astro";
import Link from "./Icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import AstroIcon from "./Icons/Astro3.astro";
import Tailwind from "./Icons/Tailwind.astro";
import Nextjs from "./Icons/Nextjs.astro";

const TAGS = {
  REACT: {
    name: "React",
    class: "border border-[#A78BFA]/25 bg-[#211C30] text-[#D5CCE4]",
    icon: React,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "border border-[#A78BFA]/35 bg-[#A78BFA]/15 text-[#CBBEFF]",
    icon: TypeScript,
  },
  ASTRO: {
    name: "Astro",
    class: "border border-[#A78BFA]/25 bg-[#211C30] text-[#D5CCE4]",
    icon: AstroIcon,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "border border-[#FB8B6B]/40 bg-[#3B2428] text-[#FFB09A]",
    icon: Tailwind,
  },
  NEXT: {
    name: "Next.js",
    class: "border border-[#A78BFA]/25 bg-[#211C30] text-[#D5CCE4]",
    icon: Nextjs,
  },
};
interface Props {
  link?: string;
  github?: string;
}
const PROJECTS = [
  {
    title: "Novition",
    description:
      "Un espacio de trabajo organizado e innovador inspirado en Notion para la productividad y la creatividad.",
    github: "https://github.com/LuisMy1715Y/Noviton-clone",
    image: "/projects/novition.webp",
    tags: [TAGS.NEXT, TAGS.TYPESCRIPT, TAGS.TAILWIND],
    link: "https://noviton-clone.vercel.app/",
  },
  {
    title: "Portafolio Web",
    description:
      "Portafolio web personal. +5 proyectos destacados. +1 años de experiencia. Desarrollado desde cero con Astro y Tailwind CSS.",
    github: "https://github.com/LuisMy1715Y/portafolio.web",
    image: "/projects/portafolioweb.webp",
    tags: [TAGS.ASTRO, TAGS.TAILWIND],
    link: "",
  },
];
---

<div class="flex flex-wrap justify-center gap-8">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="group flex w-full flex-col overflow-hidden rounded-2xl border border-[#A78BFA]/25 bg-[#201C2B]/80 shadow-xl shadow-black/25 backdrop-blur-xl transition duration-300 md:basis-[calc((100%_-_4rem)/3)] md:hover:-translate-y-1 md:hover:border-[#F472B6]/55 md:hover:shadow-2xl md:hover:shadow-[#D65DB1]/20">
        <div class="w-full overflow-hidden border-b border-[#A78BFA]/20 bg-[#171421]">
          <div class="relative overflow-hidden">
            <img
              alt="Recién llegado vs 5 años en Nueva Zelanda"
              class="h-56 w-full object-cover object-top transition duration-500 md:group-hover:scale-105"
              src={image}
            />
          </div>
        </div>

        <div class="flex flex-1 flex-col p-6">
          <h3 class="text-2xl font-bold text-[#CBBEFF]">{title}</h3>
          <div class="mt-2 flex flex-1 flex-col">
            <ul class="mb-2 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-pretty text-[#B7AEC8]">{description}</div>
            <footer class="mt-auto flex items-end justify-start gap-3 pt-6">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  GitHub
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Ir al Sitio
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
