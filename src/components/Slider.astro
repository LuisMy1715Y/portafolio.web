---
import AstroIcon from "./Icons/Astro3.astro";
import CSharpIcon from "./Icons/CSharp.astro";
import CssIcon from "./Icons/Css.astro";
import GitHubIcon from "./Icons/GitHub.astro";
import HtmlIcon from "./Icons/Html.astro";
import JavaScriptIcon from "./Icons/JavaScript.astro";
import NextjsIcon from "./Icons/Nextjs.astro";
import N8nIcon from "./Icons/N8n.astro";
import ReactIcon from "./Icons/React.astro";
import TailwindIcon from "./Icons/Tailwind.astro";
import TypeScriptIcon from "./Icons/TypeScript.astro";

const skills = [
  { name: "HTML", icon: HtmlIcon },
  { name: "CSS", icon: CssIcon },
  { name: "JavaScript", icon: JavaScriptIcon },
  { name: "C#", icon: CSharpIcon },
  { name: "n8n", icon: N8nIcon },
  { name: "Astro", icon: AstroIcon },
  { name: "React", icon: ReactIcon },
  { name: "Next.js", icon: NextjsIcon },
  { name: "TypeScript", icon: TypeScriptIcon },
  { name: "Tailwind CSS", icon: TailwindIcon },
  { name: "GitHub", icon: GitHubIcon },
];
---

<section class="skills-slider" aria-label="Tecnologías con las que trabajo">
  <div class="skills-grid">
  {
    skills.map((skill) => (
      <div class="skill-card">
        <skill.icon
          class={`skill-icon ${skill.name === "Astro" ? "skill-icon--astro" : ""}`}
          aria-hidden="true"
        />
        <span>{skill.name}</span>
      </div>
    ))
  }
  </div>
  <div class="skills-grid skills-grid--duplicate" aria-hidden="true">
    {
      skills.map((skill) => (
        <div class="skill-card">
          <skill.icon
            class={`skill-icon ${skill.name === "Astro" ? "skill-icon--astro" : ""}`}
            aria-hidden="true"
          />
          <span>{skill.name}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .skills-slider {
    width: 100%;
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .skills-grid--duplicate {
    display: none;
  }

  .skill-card {
    display: flex;
    position: relative;
    width: clamp(7rem, 20vw, 8rem);
    aspect-ratio: 1;
    flex: 0 1 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    overflow: hidden;
    border: 1px solid rgb(167 139 250 / 0.28);
    border-radius: 0.45rem;
    background: linear-gradient(145deg, rgb(38 31 54 / 0.95), rgb(24 22 34 / 0.96));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04), 0 8px 24px rgb(0 0 0 / 0.18);
    color: #e2dbed;
    font-size: 0.8rem;
    font-weight: 650;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease;
  }

  .skill-card::before {
    position: absolute;
    top: -3rem;
    left: 50%;
    width: 7rem;
    height: 5rem;
    border-radius: 9999px;
    background: rgb(167 139 250 / 0.12);
    content: "";
    filter: blur(18px);
    transform: translateX(-50%);
  }

  .skill-card:hover {
    border-color: rgb(244 114 182 / 0.55);
    background: linear-gradient(145deg, #32243d, #211b30);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 10px 28px rgb(214 93 177 / 0.18);
  }

  .skill-icon {
    position: relative;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    filter: drop-shadow(0 3px 5px rgb(0 0 0 / 0.25));
    opacity: 1;
  }

  .skill-card span {
    position: relative;
    z-index: 1;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.35);
  }

  .skill-icon--astro :global(path[fill="#fff"]) {
    fill: #f4f1fa;
  }

  @media (max-width: 1535px) {
    .skills-slider {
      display: flex;
      width: calc(100% + 1rem);
      margin-inline: -0.5rem;
      padding-inline: 0.5rem;
      overflow: hidden;
      gap: 0.75rem;
      mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    }

    .skills-grid,
    .skills-grid--duplicate {
      display: flex;
      width: max-content;
      flex: 0 0 auto;
      flex-wrap: nowrap;
      animation: skills-marquee 30s linear infinite;
    }

    .skill-card {
      width: 7rem;
    }
  }

  @keyframes skills-marquee {
    to {
      transform: translateX(calc(-100% - 0.75rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skills-grid,
    .skills-grid--duplicate {
      animation: none;
    }
  }

</style>
