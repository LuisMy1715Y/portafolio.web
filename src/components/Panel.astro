---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article class="panel">
  <h3 class="panel-title">{title}</h3>
  <slot />
</article>

<style>
  .panel {
    display: grid;
    align-content: start;
    gap: var(--space-6);
    height: 100%;
    padding: var(--space-6);
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .panel-title {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }
</style>
