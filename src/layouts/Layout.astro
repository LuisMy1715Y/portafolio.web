---
import "@fontsource-variable/onest";
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · Desarrollador de Software Junior`,
  description = `${profile.name}, desarrollador de software junior en ${profile.location}. Frontend con React, Next.js, TypeScript y Astro, y APIs con NestJS. Estudiante de Ingeniería de Software.`,
} = Astro.props;

const canonical = new URL("/", Astro.site ?? Astro.url).href;
const ogImage = new URL(profile.photo, Astro.site ?? Astro.url).href;
const themeColor = { light: "#fafaf9", dark: "#111113" };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColor.dark} media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`Retrato de ${profile.name}`} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (() => {
        const read = () => {
          try {
            return localStorage.getItem("theme");
          } catch {
            return null;
          }
        };
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = read() ?? (prefersDark ? "dark" : "light");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <slot />
    <Footer />
    <SpeedInsights />
    <Analytics />
  </body>
</html>
